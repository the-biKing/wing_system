{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32: Flash wingUI (Auto Port)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/flash.ps1\" -Sketch wingUI",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "ESP32: Flash wingUI + Serial Monitor",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/flash.ps1\" -Sketch wingUI -Monitor",
      "problemMatcher": []
    },
    {
      "label": "ESP32: Compile wingUI (Check Syntax)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/flash.ps1\" -Sketch wingUI -CompileOnly",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ESP32: Flash wingUI_sprmini",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/flash.ps1\" -Sketch wingUI_sprmini",
      "problemMatcher": []
    },
    {
      "label": "ESP32: Serial Monitor (COM3, 115200)",
      "type": "shell",
      "command": "& \"G:/Arduino/Arduino IDE/resources/app/lib/backend/resources/arduino-cli.exe\" monitor -p COM3 -c baudrate=115200",
      "problemMatcher": []
    }
  ]
}
